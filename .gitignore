# admin.html is now deployed (gated by Cloudflare Access) — it must NOT be ignored.

# OS cruft
.DS_Store

# Local dev secrets for `wrangler pages dev` — never commit
.dev.vars

# Wrangler local state (local D1 sqlite, caches)
.wrangler/

# npm — the pinned wrangler CLI (package.json). Never deployed; Pages serves
# the repo root as-is, so this must not reach the site.
node_modules/

# Impeccable
.impeccable/
# Squad: ignore runtime state (logs, inbox, sessions)
# Note: .squad/casting/* is identity and MUST be committed to main, not ignored
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
.squad/.cache/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream
